#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
/coverage/

# Database exports contain personal data - never commit them
backup/
*.export.json

# Machine-specific SDK paths
local.properties
**/android/.gradle/
**/android/captures/
**/android/app/.cxx/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase — machine-generated credentials, created by `flutterfire configure`.
# Keep these out of version control; each developer/CI runs the configure step.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/ios/firebase_app_id_file.json
/macos/Runner/GoogleService-Info.plist
.firebase/
