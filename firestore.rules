rules_version = '2';

// Evangelist Global — multi-tenant isolation rules.
//
// Every tenant lives under /schools/{schoolId}. A user may only touch data for a
// school they are a member of, proven by the existence of
// /schools/{schoolId}/members/{uid}. Membership role drives write access.
//
// The membersLookup path is the source of truth and needs no Cloud Functions.
// If you later mint a custom claim `schoolId` (see docs/MULTI_TENANCY.md) you can
// add `request.auth.token.schoolId == sid` as a fast-path in isMember().

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberPath(sid) {
      return /databases/$(database)/documents/schools/$(sid)/members/$(request.auth.uid);
    }

    function isMember(sid) {
      return isSignedIn() && exists(memberPath(sid));
    }

    function memberRole(sid) {
      return get(memberPath(sid)).data.role;
    }

    function roleIn(sid, roles) {
      return isMember(sid) && (memberRole(sid) in roles);
    }

    function isSchoolAdmin(sid) {
      return roleIn(sid, ['schoolAdmin']);
    }

    // Per-user tenant binding. Read/written by the user only; the app reads this
    // at launch to learn which school (if any) the account belongs to.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /schools/{sid} {
      // A signed-in user may claim a brand-new school id, stamping themselves as
      // owner. Onboarding then creates their schoolAdmin membership in the same
      // batch (see the members rule below).
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && !exists(/databases/$(database)/documents/schools/$(sid));

      allow read:   if isMember(sid);

      // ownerUid is immutable once set.
      allow update: if isSchoolAdmin(sid)
                    && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if false;

      match /members/{muid} {
        allow read: if isMember(sid);

        // Bootstrap: the school owner creates their own schoolAdmin membership,
        // in the SAME batch that creates the school — so we check the school doc
        // with getAfter() (post-commit state), not get(). Afterwards, only an
        // existing schoolAdmin manages members.
        allow create: if isSchoolAdmin(sid)
                      || (
                        request.auth.uid == muid
                        && request.resource.data.role == 'schoolAdmin'
                        && getAfter(/databases/$(database)/documents/schools/$(sid)).data.ownerUid == request.auth.uid
                      );

        allow update, delete: if isSchoolAdmin(sid);
      }

      match /classes/{doc} {
        allow read:  if isMember(sid);
        allow write: if roleIn(sid, ['schoolAdmin', 'teacher']);
      }

      match /students/{doc} {
        allow read:  if isMember(sid);
        allow write: if roleIn(sid, ['schoolAdmin', 'teacher']);
      }

      match /teachers/{doc} {
        allow read:  if isMember(sid);
        allow write: if isSchoolAdmin(sid);
      }

      match /documents/{doc} {
        allow read:  if isMember(sid);
        allow write: if roleIn(sid, ['schoolAdmin', 'teacher']);
      }

      match /announcements/{doc} {
        allow read:  if isMember(sid);
        allow write: if roleIn(sid, ['schoolAdmin', 'teacher']);
      }

      match /promotions/{doc} {
        allow read:  if isMember(sid);
        allow write: if isSchoolAdmin(sid);
      }

      // Any subcollection not listed above is denied by Firestore's
      // default-deny — do not add a catch-all `allow` here.
    }
  }
}
