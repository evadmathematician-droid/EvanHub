rules_version = '2';

// Evangelist Global — tenant-isolated file storage.
//
// School documents live under schools/{schoolId}/documents/{fileName}. Access is
// gated on the same Firestore membership record used by firestore.rules, so a
// user can only reach files for a school they belong to.

service firebase.storage {
  match /b/{bucket}/o {

    function isMemberOf(schoolId) {
      return request.auth != null
        && firestore.exists(
             /databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)
           );
    }

    function memberRoleOf(schoolId) {
      return firestore.get(
        /databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)
      ).data.role;
    }

    match /schools/{schoolId}/documents/{fileName} {
      allow read: if isMemberOf(schoolId);
      allow write: if isMemberOf(schoolId)
                   && memberRoleOf(schoolId) in ['schoolAdmin', 'teacher']
                   && request.resource.size < 25 * 1024 * 1024;
    }

    match /schools/{schoolId}/logo/{fileName} {
      allow read: if isMemberOf(schoolId);
      allow write: if isMemberOf(schoolId) && memberRoleOf(schoolId) == 'schoolAdmin';
    }
  }
}
